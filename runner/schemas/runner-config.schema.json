{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://combycode.io/schemas/dpe/runner-config.schema.json",
  "title": "DPE Runner Configuration",
  "description": "Schema for runner's own config file (default ~/.dpe/config.toml). TOML/JSON/YAML input; this schema describes the parsed structure.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "tools_paths": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Additional tool directories searched in order after a pipeline's tools/ folder, before the built-in registry."
    },
    "control_pipe": {
      "type": "string",
      "description": "Reserved: accepted, has no effect yet (dpe warns when it is set to a non-default value)."
    },
    "logger_pipe": {
      "type": "string",
      "description": "Reserved: accepted, has no effect yet (dpe warns when it is set to a non-default value)."
    },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_events": {
          "type": "integer",
          "minimum": 1,
          "default": 10000
        },
        "flush_ms": {
          "type": "integer",
          "minimum": 1,
          "default": 1000
        },
        "max_segment_bytes": {
          "type": "integer",
          "minimum": 1048576,
          "default": 268435456
        },
        "max_labels_per_record": {
          "type": "integer",
          "minimum": 1,
          "default": 10
        },
        "max_labels_chars_total": {
          "type": "integer",
          "minimum": 1,
          "default": 1000
        },
        "channel_capacity": {
          "type": "integer",
          "minimum": 1,
          "default": 100000
        }
      }
    },
    "cache": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default_mode": {
          "type": "string",
          "enum": [
            "use",
            "refresh",
            "bypass",
            "off"
          ],
          "default": "use",
          "description": "Cache mode when neither --cache nor the variant's settings.cache_default_mode sets one."
        },
        "shard_depth": {
          "type": "integer",
          "default": 2,
          "description": "Reserved: accepted, has no effect yet (dpe warns when it is set to a non-default value)."
        }
      }
    },
    "spawn": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_restarts": {
          "type": "integer",
          "minimum": 0,
          "default": 3,
          "description": "Reserved: accepted, has no effect yet (dpe warns when it is set to a non-default value)."
        },
        "restart_backoff_ms": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "default": [
            500,
            2000,
            5000
          ],
          "description": "Reserved: accepted, has no effect yet (dpe warns when it is set to a non-default value)."
        },
        "sigterm_grace_ms": {
          "type": "integer",
          "minimum": 0,
          "default": 10000,
          "description": "Grace period before a stopping tool is killed."
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "recommended_max_sessions": {
          "type": "integer",
          "minimum": 1,
          "default": 50,
          "description": "Reserved: accepted, has no effect yet (dpe warns when it is set to a non-default value)."
        }
      }
    },
    "default_install_path": {
      "type": "string",
      "description": "Destination for `dpe install <name>`. Default ~/.dpe/tools."
    },
    "tools_registries": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "catalog.json-shaped registries for `dpe install` / `dpe tools list`, merged first-match-wins."
    },
    "log_sink": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "flush_ms": {
          "type": "integer",
          "minimum": 1,
          "default": 250
        },
        "channel_capacity": {
          "type": "integer",
          "minimum": 1,
          "default": 4096
        },
        "tail_default": {
          "type": "integer",
          "minimum": 1,
          "default": 50
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "journal_flush_ms": {
          "type": "integer",
          "minimum": 1,
          "default": 2000
        },
        "control_channel_cap": {
          "type": "integer",
          "minimum": 1,
          "default": 32
        },
        "duplex_buf_bytes": {
          "type": "integer",
          "minimum": 1,
          "default": 65536
        },
        "monitor_poll_ms": {
          "type": "integer",
          "minimum": 1,
          "default": 500
        },
        "http_timeout_secs": {
          "type": "integer",
          "minimum": 1,
          "default": 120
        }
      }
    },
    "dev": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workspace": {
          "type": "string",
          "description": "Written by `dpe-dev setup`; not read yet."
        },
        "frameworks_cache": {
          "type": "string",
          "description": "Reserved: accepted, has no effect yet (dpe warns when it is set to a non-default value)."
        }
      }
    }
  }
}
